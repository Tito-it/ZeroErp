{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "guards": "run-s guard:*",
    "guard:liste": "node scripts/check-liste-configurabili.mjs",
    "guard:filtri": "node scripts/check-filtri-lista.mjs",
    "guard:pinia": "node scripts/check-pinia-user-scoped-reset.mjs",
    "guard:drawer": "node scripts/check-drawer-width.mjs",
    "guard:icone": "node scripts/check-primeicons-codepoints.mjs",
    "guard:keepalive": "node scripts/check-keepalive-onactivated.mjs",
    "guard:datatable": "node scripts/check-datatable-baseline.mjs",
    "guard:dialog": "node scripts/check-dialog-chrome.mjs",
    "guard:capability": "node scripts/check-capability-contratto.mjs",
    "guard:lista-stato": "node scripts/check-lista-stato-esposto.mjs",
    "guard:api-componenti": "node scripts/check-api-componenti.mjs",
    "guard:media-soglie": "node scripts/check-media-soglie.mjs",
    "guard:confini-domini": "node scripts/check-confini-domini.mjs",
    "guard:campo-codice": "node scripts/check-campo-codice.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "verify": "run-s lint guards test:run build",
    "fix": "oxlint . --fix && eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "@vue/devtools-api": "^8.2.1",
    "axios": "^1.21.0",
    "chart.js": "^4.6.1",
    "pinia": "^4.1.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.90.0",
    "eslint-plugin-vue": "~10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.90.0",
    "prettier": "3.9.10",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
