databaseChangeLog:
  

  - changeSet:
      id: 20250606-13-trgfn_gestori_ins_upd_check_ruolo_gestore_v2
      author: mctit
      runOnChange: true
      validCheckSums:
        - ANY
      changes:
        - sql:
            splitStatements: false
            sql: |
              DROP FUNCTION IF EXISTS anagrafiche.trgfn_gestori_ins_upd_check_ruolo_gestore();
        - sqlFile:
            path: sql/trgfn_gestori_ins_upd_check_ruolo_gestore_v2.sql
            relativeToChangelogFile: true
            splitStatements: false
            stripComments: false

# Metto un  tag fine modifiche
  - changeSet:
      id: 20250602-90-trgfn_gestori_ins_upd_check_ruolo_gestore_v2
