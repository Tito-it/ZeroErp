databaseChangeLog:
  - changeSet:
      id: 20250808-11-create-pgagent-job-apply-storicizza-weekly
      author: mctit
      runOnChange: true
      validCheckSums:
        - ANY
      comments: >
        Crea o aggiorna un job in pgAgent per invocare settimanalmente
        dbops.apply_storicizza_defaults() ogni sabato alle 07:00.
      
      preConditions:
        onFail: CONTINUE
        onError: CONTINUE
        tableExists:
            schemaName: pgagent
            tableName: pga_job
      changes:
        - sql:
            splitStatements: false
            stripComments: false
            sql: |
              DO $$
              DECLARE
                v_jobid   INTEGER;
                v_classid INTEGER;
              BEGIN
                -- 1) Ottengo l'ID della classe 'Routine Maintenance'
                SELECT jclid
                  INTO v_classid
                  FROM pgagent.pga_jobclass
                 WHERE jclname = 'Routine Maintenance'
                 LIMIT 1;

                IF v_classid IS NULL THEN
                  RAISE EXCEPTION 'Job class "Routine Maintenance" non trovata';
                END IF;

                -- 2) Elimino eventuale job esistente
                DELETE FROM pgagent.pga_job
                 WHERE jobname = 'apply_storicizza_weekly';

                -- 3) Creo il job
                INSERT INTO pgagent.pga_job(
                  jobjclid, jobname, jobdesc, jobenabled
                ) VALUES (
                  v_classid,
                  'apply_storicizza_weekly',
                  'Setta DEFAULT=true su colonne storicizza ogni sabato ore 07:00',
                  true
                )
                RETURNING jobid
                INTO v_jobid;

                -- 4) Schedule: sabato ore 07:00
                INSERT INTO pgagent.pga_schedule(
                  jscjobid, jscname, jscenabled,
                  jscminutes, jschours, jscweekdays,
                  jscmonthdays, jscmonths, jscstart
                ) VALUES (
                  v_jobid,
                  'sat_07',
                  true,
                  (SELECT array_agg((i = 0)::boolean) FROM generate_series(0,59) AS g(i)),
                  (SELECT array_agg((i = 7)::boolean) FROM generate_series(0,23) AS g(i)),
                  ARRAY[FALSE,FALSE,FALSE,FALSE,FALSE,FALSE,TRUE]::boolean[],
                  array_fill(TRUE, ARRAY[32])::boolean[],
                  array_fill(TRUE, ARRAY[12])::boolean[],
                  now()
                );

                -- 5) Step: richiamo la procedura
                INSERT INTO pgagent.pga_jobstep(
                  jstjobid, jstname, jstkind, jstcode, jstdbname
                ) VALUES (
                  v_jobid,
                  'run_apply_storicizza',
                  's',
                  $step$
                    SELECT dbops.apply_storicizza_defaults();
                  $step$,
                  current_database()
                );
              END;
              $$;

# Metto un  tag fine modifiche
  - changeSet:
      id: 20250808-90-create-pgagent-job-apply-storicizza-weekly
      author: mctit
      changes:
        - tagDatabase:
            tag: 20250808-11-create-pgagent-job-apply-storicizza-weekly