databaseChangeLog:
      # Vecchia storia INALTERATA (baseline + migrations esistenti)
      - include:
              file: changelog-master.yaml # il tuo master attuale
              relativeToChangelogFile: true

      # Nuova storia v2 AUTOGENERATA (ordine temporale globale)
      - include:
              file: migrations_v2/changelog-autogen.yaml
              relativeToChangelogFile: true
