              - column: { name: segno, valueNumeric: -1 }
              - column: { name: ambito, value: "vendite" }
              - column: { name: impatto_valorizzazione, value: "cmp" }
              - column: { name: abilita_billing, valueBoolean: true }
        - insert:
            tableName: magazzino.causali
            columns:
