              - column: { name: richiede_magazzino_dest, valueBoolean: true }
              - column: { name: abilita_billing, valueBoolean: false }
        - insert:
            tableName: magazzino.causali
            columns:
              - column: { name: codice, value: "TRASF_IN" }
              - column: { name: descrizione, value: "Trasferimento entrata" }
              - column: { name: segno, valueNumeric: 1 }
              - column: { name: ambito, value: "trasferimento" }
              - column: { name: abilita_billing, valueBoolean: false }
        - insert:
            tableName: magazzino.causali
            columns:
