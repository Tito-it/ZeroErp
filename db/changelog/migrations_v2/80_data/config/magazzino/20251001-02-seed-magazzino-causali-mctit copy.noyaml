              - column: { name: segno, valueNumeric: -1 }
              - column: { name: ambito, value: "inventario" }
              - column: { name: impatto_valorizzazione, value: "cmp" }
        - insert:
            tableName: magazzino.causali
            columns:
              - column: { name: codice, value: "INST_ASSET" }
              - column: { name: descrizione, value: "Installazione asset (contatore)" }
