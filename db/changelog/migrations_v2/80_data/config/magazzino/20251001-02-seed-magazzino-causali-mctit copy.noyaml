              - column: { name: ambito, value: "acquisti" }
              - column: { name: impatto_valorizzazione, value: "cmp" }
              - column: { name: abilita_billing, valueBoolean: false }
        - insert:
            tableName: magazzino.causali
            columns:
              - column: { name: codice, value: "SCAR_VEN" }
