databaseChangeLog:
  
  - changeSet:
      id: 20251001-02-seed-magazzino-causali
      author: mctit
      logicalFilePath: migrations_v2/80_data/20251001-02-seed-magazzino-causali.yaml
      context: seed
      changes:
        - insert:
            tableName: magazzino.causali
            columns:
              - column: { name: codice, value: "CAR_ACQ" }
