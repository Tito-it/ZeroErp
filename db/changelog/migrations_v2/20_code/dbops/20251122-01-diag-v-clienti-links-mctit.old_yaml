# ------------------------------------------------------------
# SPDX-License-Identifier: AGPL-3.0-or-later
# Liquibase changelog per Zero ERP
# View di diagnostica per verificare i legami:
#   soggetti → soggetti_ruoli → istanze_utilities → billing_account → clienti
# ------------------------------------------------------------

databaseChangeLog:
  - logicalFilePath: /migrations_v2/20_code/dbops/20251122-01-diag-v-clienti-links-mctit.yaml

  - changeSet:
      id: 20251122-01-diag-v-clienti-links
      author: mctit
      context: diag
      comment: "Crea la view dbops.diag_v_clienti_links per verificare coerenza tra clienti e billing_account."
      # runOnChange: true
      validCheckSums: [ANY]

      changes:
        - sql:
            dbms: postgresql
            splitStatements: true
            stripComments: true
            sql: |
              DROP VIEW IF EXISTS dbops.diag_v_clienti_links;
              CREATE OR REPLACE VIEW dbops.diag_v_clienti_links AS
              SELECT
                  c.id                       AS cliente_id,
                  c.soggetto_ruolo_id        AS cliente_soggetto_ruolo_id,
                  c.istanza_utility_id       AS cliente_istanza_utility_id,
                  c.utility_id               AS cliente_utility_id,
                  c.billing_account_id       AS cliente_billing_account_id,

                  ba.id                      AS ba_id,
                  ba.istanza_utility_id      AS ba_istanza_utility_id,
                  ba.soggetto_ruolo_id       AS ba_soggetto_ruolo_id,
                  ba.utility_id              AS ba_utility_id,

                  s.id                       AS soggetto_id,
                  s.codice                   AS soggetto_codice,
                  s.ragione_sociale,
                  s.cognome,
                  s.nome,

                  iu.id                      AS istanza_id,
                  iu.fittizia               AS istanza_fittizia,

                  u.id                       AS utility_id,
                  u.codice_interno           AS utility_codice_interno,
                  u.descrizione              AS utility_descrizione,

                  
                  iv.id                      AS iva_id,
                  iv.codice                  AS iva_codice,
                  iv.descrizione             AS iva_descrizione,

                  -- Flag di coerenza
                  (ba.istanza_utility_id = c.istanza_utility_id) AS ba_match_istanza,
                  (ba.soggetto_ruolo_id = c.soggetto_ruolo_id)   AS ba_match_soggetto_ruolo,
                  (ba.utility_id = c.utility_id)                 AS ba_match_utility

              FROM anagrafiche.clienti c
              LEFT JOIN anagrafiche.billing_account    ba ON ba.id = c.billing_account_id
              LEFT JOIN anagrafiche.soggetti_ruoli     sr ON sr.id = c.soggetto_ruolo_id
              LEFT JOIN anagrafiche.soggetti           s  ON s.id = sr.soggetto_id
              LEFT JOIN anagrafiche.istanze_utilities  iu ON iu.id = c.istanza_utility_id
              LEFT JOIN config.utilities               u  ON u.id = c.utility_id

              LEFT JOIN config.iva                     iv  ON iv.id = c.iva_id;

              COMMENT ON VIEW dbops.diag_v_clienti_links IS
                'View di diagnostica che mostra i legami tra clienti, billing_account, istanze_utilities, soggetti e utilities.
                 Include flag di coerenza tra clienti e billing_account: istanza, soggetto_ruolo e utility.';

  - changeSet:
      id: 20251122-02-diag-v-clienti-links
      author: mctit
      # context: test
      comment: "Crea la view dbops.diag_v_clienti_links per verificare coerenza tra clienti e billing_account."
      #  runOnChange: true
      validCheckSums: [ANY]

      changes:
        - sql:
            dbms: postgresql
            splitStatements: true
            stripComments: true
            sql: |
              DROP VIEW IF EXISTS dbops.diag_v_clienti_links;
              CREATE OR REPLACE VIEW dbops.diag_v_clienti_links AS
              ------------------------------------------------------------
              -- View di diagnostica per verificare coerenza tra clienti e billing_account
              -- clienti → billing_account → soggetti_ruoli → soggetti → istanze_utilities → utilities
              ------------------------------------------------------------
              SELECT
                  c.id                       AS cliente_id,
                  c.soggetto_ruolo_id        AS cliente_soggetto_ruolo_id,
                  c.istanza_utility_id       AS cliente_istanza_utility_id,
                  c.utility_id               AS cliente_utility_id,
                  c.billing_account_id       AS cliente_billing_account_id,

                  ba.id                      AS ba_id,
                  ba.istanza_utility_id      AS ba_istanza_utility_id,
                  ba.soggetto_ruolo_id       AS ba_soggetto_ruolo_id,
                  ba.utility_id              AS ba_utility_id,

                  s.id                       AS soggetto_id,
                  s.codice                   AS soggetto_codice,
                  s.ragione_sociale,
                  s.cognome,
                  s.nome,

                  iu.id                      AS istanza_id,
                  iu.fittizia               AS istanza_fittizia,

                  u.id                       AS utility_id,
                  u.codice_interno           AS utility_codice_interno,
                  u.descrizione              AS utility_descrizione,

                  tr.id                       AS tipo_ruolo_id,
                  tr.codice                   AS tipo_ruolo_codice_interno,
                  tr.descrizione              AS tipo_ruolo_descrizione,

                  iv.id                      AS iva_id,
                  iv.codice                  AS iva_codice,
                  iv.descrizione             AS iva_descrizione,

                  -- Flag di coerenza
                  (ba.istanza_utility_id = c.istanza_utility_id) AS ba_match_istanza,
                  (ba.soggetto_ruolo_id = c.soggetto_ruolo_id)   AS ba_match_soggetto_ruolo,
                  (ba.utility_id = c.utility_id)                 AS ba_match_utility

              FROM anagrafiche.clienti c
              LEFT JOIN anagrafiche.billing_account    ba ON ba.id = c.billing_account_id
              LEFT JOIN anagrafiche.soggetti_ruoli     sr ON sr.id = c.soggetto_ruolo_id
              LEFT JOIN anagrafiche.soggetti           s  ON s.id = sr.soggetto_id
              LEFT JOIN anagrafiche.istanze_utilities  iu ON iu.id = c.istanza_utility_id
              LEFT JOIN config.utilities               u  ON u.id  = c.utility_id
              LEFT JOIN config.tipi_ruoli              tr  ON tr.id = sr.tipo_ruolo_id
              LEFT JOIN config.iva                     iv  ON iv.id = c.iva_id;

              COMMENT ON VIEW dbops.diag_v_clienti_links IS
                'View di diagnostica che mostra i legami tra clienti, billing_account, istanze_utilities, soggetti e utilities.
                 Include flag di coerenza tra clienti e billing_account: istanza, soggetto_ruolo e utility.';
