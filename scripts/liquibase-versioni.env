# Versioni di Liquibase e del driver JDBC PostgreSQL — FONTE UNICA.
#
# Le leggono: scripts/installa-liquibase.sh (installazione e sviluppo),
# scripts/liquibase5.sh (quale driver agganciare) e i due workflow di CI
# (.github/workflows/ci.yaml, ci-validate.yaml). ⛔ Non si ricopiano altrove.
#
# Per aggiornare: si cambiano versione e SHA-256 qui, si lancia
# scripts/installa-liquibase.sh e si fa girare la CI.
#   - Liquibase: digest dell'asset liquibase-<versione>.tar.gz nella release
#     GitHub (https://github.com/liquibase/liquibase/releases).
#   - Driver: sha256sum del jar scaricato da Maven Central, confrontato con lo
#     SHA-1 che Maven pubblica accanto (postgresql-<versione>.jar.sha1).
#
# Formato: righe CHIAVE=valore, senza spazi né virgolette (lo legge anche la CI).

LIQUIBASE_VERSION=5.0.4
LIQUIBASE_SHA256=bb08638d70dddd6af8cca6e033148576f8214b5996831b1f8864eb3528f4cfce

PGJDBC_VERSION=42.7.14
PGJDBC_SHA256=73914527305a40cce504b0d3d90b23caf565136912d607ae8ae7c5895512332c
