# Template systemd — worker DRAINER coda lavori generica (dbops.coda_lavori).
# Fonte di verità versionata: NON modificare gli unit installati in
# /etc/systemd/system a mano — si editano QUI e si ri-renderizzano con
# `sudo backend/bin/install-timers.sh`. Placeholder per-host sostituiti
# dall'installer: __APP_DIR__ (cartella backend), __APP_USER__ (owner app),
# __COMANDO__ (l'argv dopo run-command.sh: dal 2026-09-14 la riga di comando
# sta in `sveglie.json`, campo `comando` — è la stessa che «Esegui ora» lancia).
[Unit]
Description=ZeroERP drainer coda lavori generica (dbops.coda_lavori)
After=network.target

[Service]
Type=oneshot
User=__APP_USER__
Group=www-data
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env.systemd
# ⛔ TimeoutStartSec, il TETTO della corsa (dal 2026-10-17): un `oneshot` senza
# tetto resta «in avvio» per sempre se qualcosa si appende, e finche' non
# finisce il timer non ne lancia un'altra — il 2026-10-16 due sveglie sono
# rimaste ferme oltre un'ora su una connessione al DB caduta a meta'.
# 8min: sotto la tolleranza del drenatore a catalogo (10 minuti) e sopra il
#   tetto di «Esegui ora» (`TETTO_SOTTOPROCESSO_SECONDI`, 5 minuti), che il
#   drenatore aspetta. Copre anche l'`ExecCondition`.
TimeoutStartSec=8min
# ⭐ Il processo e' ACCESO su questa installazione? Lo chiede `e_dovuto` al DB
# (`maintenance.fn_sveglia_accesa`, dal 2026-10-16): spento esce 1 e systemd
# salta senza errore; ambiente non dichiarato esce 255 e l'unit fallisce.
# Su ogni sveglia, anche su chi oggi non si spegne mai: e' il catalogo a dirlo.
ExecCondition=__APP_DIR__/bin/run-command.sh e_dovuto zeroerp-coda-lavori
ExecStart=__APP_DIR__/bin/run-command.sh __COMANDO__
