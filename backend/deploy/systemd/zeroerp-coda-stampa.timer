# Template systemd — timer del worker coda stampa.
# Placeholder per-host: __ONCALENDAR__ (cadenza, default installer *:0/2 = ogni
# 2 minuti; tunable, P-5 del brief cockpit). Vedi il .service gemello.
[Unit]
Description=Timer ZeroERP drainer coda stampa (vendite.fatture_stampa_coda)

[Timer]
OnCalendar=__ONCALENDAR__
Persistent=true

[Install]
WantedBy=timers.target
