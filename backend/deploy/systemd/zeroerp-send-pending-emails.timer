# Template systemd — timer del drenaggio coda email.
# Placeholder per-host: __ONCALENDAR__ (cadenza, default `*:0/5` = ogni 5
# minuti, dichiarato in `backend/deploy/sveglie.json`). Vedi il .service gemello
# per il perché di quella cadenza.
#
# ⚠️ `Persistent=true`: dopo un'interruzione (riavvio, host spento) il giro
# perso parte una volta al riaggancio. Su una coda di email conta — le righe
# PENDING restano lì e nessuno le drena finché il timer non torna.
[Unit]
Description=Timer ZeroERP drenaggio coda email

[Timer]
OnCalendar=__ONCALENDAR__
Persistent=true

[Install]
WantedBy=timers.target
