# Template systemd — digest SETTIMANALE dei presidi (dbops.presidi) + BATTITO.
# Fonte di verità versionata: si edita QUI e si ri-renderizza con
# `sudo backend/bin/install-timers.sh`. Placeholder per-host sostituiti
# dall'installer: __APP_DIR__ (cartella backend), __APP_USER__ (owner app),
# __COMANDO__ (l'argv dopo run-command.sh: dal 2026-09-14 la riga di comando
# sta in `sveglie.json`, campo `comando` — è la stessa che «Esegui ora» lancia).
# La cadenza sta in `backend/deploy/sveglie.json`, non qui.
#
# ⭐ QUESTA CORSA PARTE ANCHE QUANDO NON HA NIENTE DA DIRE, ed è la ragione per
# cui è separata dalla giornaliera. Il digest è nato contro il silenzio, ma un
# digest muto e un digest MORTO si scrivono uguale: è la firma di R-12
# (`apply_storicizza_weekly`, morto ogni settimana per sei mesi e scoperto per
# caso). ⇒ Una volta a settimana il messaggio parte comunque, con in testa le
# proprie ultime corse lette da `maintenance.job_run_log`, corsia per corsia:
# se la giornaliera è ferma da tre giorni, si vede lì.
# ⛔ E non poteva farlo il database: `dbops.vw_processi_programmazione`
# classifica i processi su canale COMMAND come FUORI_PORTATA, ed è una decisione
# — «il database non può saperlo» — non un limite da aggirare.
#
# ⚠️ Un messaggio alla settimana e non uno al giorno: «niente da segnalare» detto
# ogni mattina è esattamente la posta che si impara ad archiviare senza aprire,
# cioè il modo in cui questo presidio morirebbe di nuovo.
#
# ⚠️ Per il `OnFailure=` mancante vale la nota scritta nel gemello giornaliero:
# è un'assenza dichiarata, non una dimenticanza.
[Unit]
Description=ZeroERP digest settimanale dei presidi (registri, tendenze, battito)
After=network.target

[Service]
Type=oneshot
User=__APP_USER__
Group=www-data
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env.systemd
# ⭐ Dal 2026-10-09 il timer si sveglia OGNI ORA e questa riga decide se il
#    lavoro e' dovuto, nel fuso dell'AZIENDA (`dovuto` in sveglie.json; brief
#    un-solo-fuso-aziendale T-4/T-9): exit 1 = salta senza errore (non ancora,
#    o gia' fatto nel periodo), 255 = guasto e unit fallita. ⛔ Non sta in
#    `__COMANDO__`: quella e' la riga di «Esegui ora», che esegue sempre.
# ⛔ TimeoutStartSec, il TETTO della corsa (dal 2026-10-17): un `oneshot` senza
# tetto resta «in avvio» per sempre se qualcosa si appende, e finche' non
# finisce il timer non ne lancia un'altra — il 2026-10-16 due sveglie sono
# rimaste ferme oltre un'ora su una connessione al DB caduta a meta'.
# 30min: il digest dura secondi: e' una rete, sotto l'ora dopo cui la corsa
#   risulta «presa e mai chiusa». Copre anche l'`ExecCondition`.
TimeoutStartSec=30min
ExecCondition=__APP_DIR__/bin/run-command.sh e_dovuto zeroerp-digest-presidi-settimanale
ExecStart=__APP_DIR__/bin/run-command.sh __COMANDO__
