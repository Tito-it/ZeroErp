{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DJ: makemigrations",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": [
        "${workspaceFolder}/manage.py",
        "makemigrations"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "DJ: migrate",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": [
        "${workspaceFolder}/manage.py",
        "migrate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "DJ: collectstatic",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": [
        "${workspaceFolder}/manage.py",
        "collectstatic",
        "--noinput"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "DJ: runserver (8030)",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": [
        "${workspaceFolder}/manage.py",
        "runserver",
        "0.0.0.0:8030"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}