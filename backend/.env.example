# backend/.env.example — modello del file backend/.env
#
# Copiare in backend/.env e valorizzare. ⛔ backend/.env NON si committa:
# contiene i segreti della macchina (lo presidiano .gitignore e gitleaks).
# Qui stanno solo i NOMI delle variabili e valori d'esempio innocui.
# Lo stesso elenco, senza `export`, va in backend/.env.systemd (il servizio).
# Elenco completo delle variabili e dei default: zeroerp_backend/settings.py.

# Chiave Django: firma JWT e sessioni. Generarla con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
export DJANGO_SECRET_KEY="<generare>"
# Obbligatoria: chiavi Fernet dei segreti cifrati nel DB (crypto_service),
# separate dalla SECRET_KEY. Piu' chiavi separate da virgola: cifra la prima,
# decifrano tutte (rotazione: manage.py ricifra_campi_cifrati). Generarla con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
export DJANGO_FIELD_ENCRYPTION_KEYS="<generare>"
export DJANGO_DEBUG=0
# Obbligatoria con DEBUG=0: HSTS in secondi. 0 con un certificato
# auto-firmato; in produzione si parte da 300, verificato si sale a 31536000.
export DJANGO_SECURE_HSTS_SECONDS=0
# Redirect HTTP → HTTPS in Django: default 1 con DEBUG=0 (/health esente).
# export DJANGO_SECURE_SSL_REDIRECT=1
# Swagger (/api/docs/, /api/schema/): segue DEBUG; 1 solo su macchina di sviluppo
export DJANGO_API_DOCS_ENABLED=0
export DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"
# Obbligatoria: quanti proxy fidati stanno davanti (nginx = 1; 0 senza proxy)
export DJANGO_TRUSTED_PROXY_COUNT=1
# Obbligatoria: base dei link nelle email
export FRONTEND_URL="https://<host>"
export DB_HOST=<host>
export DB_PORT=5432
export DB_NAME="zeroerp"
export DB_USER="zeroerp_app"
export DB_PASSWORD="<password>"

# Riuso connessioni PostgreSQL in secondi.
# 600 = tiene la connessione aperta 10 minuti (utile con DB remoto + SSL).
# 0   = chiude la connessione a fine richiesta (usare con pgbouncer in transaction mode).
export CONN_MAX_AGE=600
