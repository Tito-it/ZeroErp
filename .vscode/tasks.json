{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Liquibase: validate",
      "type": "shell",
      "command": "liquibase",
      "args": [
       // "--defaults-file=${workspaceFolder:ZeroErp}/db/liquibase.properties",
        "validate"
      ],
      "options": {
        "cwd": "${workspaceFolder:ZeroErp}/db",
        "env": {
          "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64"
        }
      }
    },
    {
      "label": "Liquibase: status",
      "type": "shell",
      "command": "liquibase",
      "args": ["--defaults-file=${workspaceFolder}/db/liquibase.properties", "status", "--verbose"],
      "options": {
        "env": {
          "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Liquibase: updateSQL",
      "type": "shell",
      "command": "liquibase",
      "args": ["--defaults-file=${workspaceFolder}/db/liquibase.properties", "updateSQL"],
      "options": {
        "env": {
          "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Liquibase: update",
      "type": "shell",
      "command": "liquibase",
      "args": ["--defaults-file=${workspaceFolder}/db/liquibase.properties", "update"],
      "options": {
        "env": {
          "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Docs: serve",
      "type": "shell",
      "command": "bash",
      "args": ["-lc", "source ${workspaceFolder}/.venv/bin/activate && mkdocs serve -a 127.0.0.1:8000"],
      "problemMatcher": []
    },
    {
      "label": "Genera documentazione DB",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/gen_db_docs.py"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
