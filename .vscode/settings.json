{
  "terminal.integrated.cwd": "${workspaceFolder}",
  "files.eol": "\n",
  "editor.tabSize": 2,
  "editor.formatOnSave": true,

  // Python: non fissiamo un interpreter unico nel repo, cosi` ogni host
  // (backend-dev / db-dev) puo` ricordare il proprio interpreter selezionato.
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],
  
  "python.terminal.activateEnvironment": true,
  
  
  // YAML/Markdown comodi per Liquibase & docs
  "[yaml]": { "editor.insertSpaces": true, "editor.tabSize": 2 },
  "[markdown]": { "editor.wordWrap": "bounded" },

  // java 
  "liquibase.java.home": "/usr/lib/jvm/java-17-openjdk-amd64"
}
