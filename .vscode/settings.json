{
  "terminal.integrated.cwd": "${workspaceFolder}",
  "files.eol": "\n",
  "editor.tabSize": 2,
  "editor.formatOnSave": true,

  // Python (se usi venv locale al repo)
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  
  // YAML/Markdown comodi per Liquibase & docs
  "[yaml]": { "editor.insertSpaces": true, "editor.tabSize": 2 },
  "[markdown]": { "editor.wordWrap": "bounded" },

  // java 
  "liquibase.java.home": "/usr/lib/jvm/java-17-openjdk-amd64"
}
